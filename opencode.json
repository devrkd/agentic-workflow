{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-flash",
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "task": {
      "enabled": false,
      "type": "remote",
      "url": "https://your-task-provider.example/mcp/",
      "headers": {
        "Authorization": "Bearer {env:TASK_PROVIDER_TOKEN}"
      }
    },
    "documentation": {
      "enabled": false,
      "type": "remote",
      "url": "https://your-documentation-provider.example/mcp/",
      "headers": {
        "Authorization": "Bearer {env:DOCUMENTATION_PROVIDER_TOKEN}"
      }
    },
    "ux": {
      "enabled": false,
      "type": "local",
      "command": ["npx", "-y", "<your-ux-provider-mcp>", "--stdio"],
      "environment": {
        "UX_PROVIDER_TOKEN": "{env:UX_PROVIDER_TOKEN}"
      }
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "echo *": "allow",
      "pwd": "allow",
      "which *": "allow",
      "env": "allow",
      "printenv *": "allow",
      "jq *": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git remote*": "allow",
      "git fetch*": "allow",
      "git stash list*": "allow",
      "git worktree list*": "allow",
      "git -C * worktree list*": "allow",
      "git -C * status*": "allow",
      "git -C * log*": "allow",
      "git -C * diff*": "allow",
      "git -C * branch*": "allow",
      "git -C * remote*": "allow",
      "gh auth status*": "allow",
      "gh pr *": "allow",
      "gh issue *": "allow",
      "gh repo *": "allow",
      "gh run *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git push *": "allow",
      "git checkout *": "allow",
      "git switch *": "allow",
      "git -C * add *": "allow",
      "git -C * commit *": "allow",
      "git -C * push *": "allow",
      "git -C * checkout *": "allow",
      "git -C * switch *": "allow",
      "git -C * worktree add *": "allow",
      "scripts/*.sh *": "allow",
      "mkdir -p *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "touch *": "allow",
      "chmod *": "allow",
      "npm *": "allow",
      "node *": "allow",
      "npx *": "allow",
      "curl *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "awk *": "allow",
      "tr *": "allow",
      "date *": "allow",
      "rm *": "deny",
      "rmdir *": "deny",
      "git -C * worktree remove *": "deny",
      "git branch -D *": "deny",
      "git branch -d *": "deny",
      "git push --force*": "deny",
      "git reset --hard*": "deny",
      "git clean *": "deny"
    }
  }
}
