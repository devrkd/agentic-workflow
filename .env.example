CLICKUP_API_TOKEN=replace_me
# Optional: set only if your MCP server requires workspace scoping.
# CLICKUP_TEAM_ID=replace_me
GITHUB_TOKEN=replace_me
SLITE_API_TOKEN=replace_me
FIGMA_API_KEY=replace_me

# --- Slack bridge (opencode plugin) ---
# Bot token from OAuth & Permissions (starts with xoxb-).
SLACK_BOT_TOKEN=replace_me
# App-level token for Socket Mode (starts with xapp-, needs connections:write).
SLACK_APP_TOKEN=replace_me
# Channel ID to post per-session threads into, e.g. C0123ABCD.
SLACK_CHANNEL=replace_me
# Comma-separated Slack user IDs allowed to answer approvals. Strongly recommended;
# if empty any member of the channel can approve agent commands.
SLACK_ALLOWED_USERS=
# Set to off to disable the bridge without removing the tokens above.
SLACK_BRIDGE=on
